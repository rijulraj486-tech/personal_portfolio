# Optional: GitHub account whose public repositories and profile link appear in the portfolio.
# Values prefixed with NEXT_PUBLIC_ are included in the browser bundle; do not put secrets here.
NEXT_PUBLIC_GITHUB_USERNAME=

# Server-only Resend settings for contact-form delivery. Never prefix these with NEXT_PUBLIC_.
RESEND_API_KEY=
CONTACT_EMAIL=
RESEND_FROM_EMAIL=
